{
    "name": "cpy-pst-gmbh/plentymarkets-bundle",
    "description": "Plentymarkets API",
    "license": "UNLICENSED",
    "authors": [
        {
            "name": "Sven Joder",
            "email": "sj@pmdevelopment.de"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-xml": "*",
        "doctrine/persistence": "^3.4 || ^4.0",
        "guzzlehttp/guzzle": "^7.4 || ^8.0",
        "phpstan/phpdoc-parser": "^2.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/form": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/polyfill-php86": "*",
        "symfony/property-info": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/type-info": "^8.0",
        "symfony/yaml": "^8.0",
        "twig/twig": "^3.0",
        "phpdocumentor/type-resolver": "^1.10 || ^2.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "symfony/framework-bundle": "^8.0"
    },
    "suggest": {
        "doctrine/orm": "To keep tokens, API locks and limits in a relational database",
        "doctrine/mongodb-odm": "To keep them in MongoDB instead"
    },
    "autoload": {
        "psr-4": {
            "PM\\PlentyMarketsBundle\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PM\\PlentyMarketsBundle\\Tests\\": "Tests/"
        }
    }
}
