{
    "name": "cpy-pst-gmbh/plentymarkets-bundle",
    "description": "Plentymarkets API",
    "license": "UNLICENSED",
    "authors": [
        {
            "name": "Sven Joder",
            "email": "sj@pmdevelopment.de"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-xml": "*",
        "jms/serializer": "*",
        "symfony/polyfill-php86": "*",
        "symfony/form": "*",
        "symfony/dependency-injection": "*",
        "guzzlehttp/guzzle": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "PM\\PlentyMarketsBundle\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "require-dev": {
        "doctrine/orm": "*",
        "doctrine/persistence": "*",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "psr/log": "*",
        "symfony/http-foundation": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "PM\\PlentyMarketsBundle\\Tests\\": "Tests/"
        }
    }
}
